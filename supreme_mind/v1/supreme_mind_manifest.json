  "constitutional_rules": {
    "canonicalization_authority": "SCQOS-C14N-JCS-NFC-1",
    "states": [
      "PERMIT",
      "HOLD",
      "REJECT"
    ],
    "rule_1": "No digital faculty may bypass SCQOS for a consequential external action.",
    "rule_2": "Read, search, analysis, monitoring and drafting may operate autonomously when they do not mutate protected external state.",
    "rule_3": "External mutations require role authority, evidence and an explicitly registered tool/action contract.",
    "rule_4": "Money, legal commitments, protected health information, employment decisions, security policy, physical safety, destructive production mutations and other high-consequence actions require attributable human authorization unless a future contract explicitly proves a narrower admissible delegation.",
    "rule_5": "Missing authority, missing evidence, unknown tools, stale contracts or governance failure become HOLD or REJECT, never implicit PERMIT.",
    "rule_6": "Every admitted consequential transition produces a durable receipt.",
    "rule_7": "All faculties share the sovereign principal but do not automatically share unrestricted permissions.",
    "rule_8": "Evolution of a faculty, policy, model or tool contract requires versioning and requalification before the new state becomes authoritative."
  },
