    "allowed_role_ids",
    "allowed_actions",
    "credential_reference",
    "evidence_requirements",
    "consequence_verification",
    "risk_class",
    "version"
  ],
  "examples": [
    "email",
    "calendar",
    "CRM",
    "customer_support",
    "inventory",
    "ecommerce",
    "website CMS",
    "analytics",
    "cloud deployment",
    "accounting",
    "payments",
    "scheduling",
    "social publishing"
  ],
  "rule": "No unregistered adapter receives consequential execution authority."
}
